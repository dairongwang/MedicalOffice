# Local development settings of the Medic Office API (services/account).
#
# `python dev.py setup` copies this file to services/account/.env (gitignored) when there is none.
# KEY=VALUE lines; real environment variables win. Every value below is a DUMMY meant for a developer
# machine — nothing here is a real credential. Leave a provider's settings empty / commented out and the
# built-in fake of that provider answers instead (outside production): messages land in the test inbox
# (http://localhost:8000/api/v1/messages/fake/outbox), payments go through the fake Stripe / PayPal pages,
# "Sign in with Google / Facebook / Apple" shows a fake consent screen.

# ---- Environment -----------------------------------------------------------------------------------
# dev | test | qa | staging | prod   (prod: the fakes and the dummy data are off, TOKEN_SECRET is required)
APP_ENV=dev

# Signs the session tokens (and keys the payment-method fingerprints). Fixed here so that restarting the
# development server does not sign everybody out. Generate a real one for any shared deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SECRET=dummy-dev-token-secret-not-for-production-0123456789

# ---- Database --------------------------------------------------------------------------------------
# Unset: `python dev.py run` uses the local PostgreSQL (python dev.py db init / start) when it answers,
# otherwise SQLite in services/account/data/account.db.
# DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/assistant
# PGPORT=5432

# ---- Dummy data --------------------------------------------------------------------------------------
# Create the dummy accounts, staff, patients, visits (incl. a signed visit summary) at every start.
SEED_FAKE_ACCOUNTS=true
# Accounts with these e-mails become administrators when they register / sign in (comma-separated).
# ADMIN_EMAILS=dummy-you@example.com

# ---- The office ------------------------------------------------------------------------------------
OFFICE_NAME=Medic Office
OFFICE_ADDRESS=1 Example Street, Exampleville (dummy)
# A number from the 555-01xx range reserved for fiction.
OFFICE_PHONE=+1 555 010 0000
# IANA time zone the agenda, the slots and the documents use (e.g. America/New_York).
OFFICE_TIMEZONE=UTC
# Where the office is told about referrals / assistants who cannot do a task (empty = dashboard only).
# OFFICE_NOTIFY_EMAIL=dummy-frontdesk@example.com
# OFFICE_NOTIFY_PHONE=+1 555 010 0003

# ---- E-mail (SMTP) — empty: the built-in fake outbox -------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=dummy-smtp-user
# SMTP_PASSWORD=dummy-smtp-password
# EMAIL_FROM=Medic Office <dummy-no-reply@example.com>

# ---- Text messages (Twilio) — empty: the built-in fake outbox ----------------------------------------
# TWILIO_ACCOUNT_SID=ACdummy00000000000000000000000000
# TWILIO_AUTH_TOKEN=dummy-twilio-auth-token
# TWILIO_FROM=+15550100000

# ---- Payments — empty: the built-in fakes of Stripe and PayPal (fakes.py) -----------------------------
# STRIPE_SECRET_KEY=sk_test_dummy_replace_with_your_test_key
# STRIPE_WEBHOOK_SECRET=whsec_dummy_replace_with_your_webhook_secret
# PAYPAL_CLIENT_ID=dummy-paypal-client-id
# PAYPAL_CLIENT_SECRET=dummy-paypal-client-secret
# PAYPAL_WEBHOOK_ID=dummy-paypal-webhook-id
# PAYPAL_PLAN_PRO_MONTHLY=P-DUMMYMONTHLYPLANID
# PAYPAL_PLAN_PRO_YEARLY=P-DUMMYYEARLYPLANID
# PAYPAL_ENV=sandbox

# ---- Sign in with Google / Facebook / Apple — empty: the built-in fake consent screens -----------------
# GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=dummy-google-client-secret
# FACEBOOK_APP_ID=dummy-facebook-app-id
# FACEBOOK_APP_SECRET=dummy-facebook-app-secret

# ---- Releases ----------------------------------------------------------------------------------------
# The deploy pipeline's token for POST /api/v1/release/publish (python dev.py publish <url>).
RELEASE_ADMIN_TOKEN=dummy-release-admin-token
