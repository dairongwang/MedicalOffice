{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "version": "1.0.0",
    "schemaVersion": 2,
    "minSupportedVersion": "1.0.0",
    "minSupportedSchema": 2,
    "critical": false,
    "channel": "stable",
    "notes": "Patients tab: registration and appointment scheduling (book, see and cancel visits with a doctor or nurse). Optional account with end-to-end-encrypted sync, automatic updates."
  },
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/icons/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-never-cached",
      "urls": [
        "/api/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 0,
        "maxAge": "0u",
        "timeout": "0u"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**",
    "!/staff",
    "!/staff/**",
    "!/admin",
    "!/admin/**",
    "!/ads-admin",
    "!/ads-admin/**",
    "!/sw.js"
  ]
}
